# ============================================================
# Lead Research Agent — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- REQUIRED ---
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- OPTIONAL but RECOMMENDED ---
# Get from: https://console.cloud.google.com/apis/library/places.googleapis.com
# Without this key, the agent runs in MOCK MODE (generated test data)
GOOGLE_PLACES_API_KEY=

# --- CONFIGURATION ---
# How often to run a research cycle (cron expression, default: every 4 hours)
RESEARCH_CRON=0 */4 * * *

# Minimum lead score to save (0-100, default: 40)
MIN_LEAD_SCORE=40

# Path to SQLite database file
DB_PATH=./data/leads.db

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Target country/region for searches (affects mock data too)
TARGET_REGION=South Africa

# Max businesses to check per research cycle
MAX_BUSINESSES_PER_CYCLE=20

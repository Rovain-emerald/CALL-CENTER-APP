# Veritas Call Center - Environment Configuration
# Copy this file to .env and fill in your actual values

# API Configuration
EXPO_PUBLIC_API_URL=https://api.veritas-platform.co.za
EXPO_PUBLIC_WS_URL=wss://ws.veritas-platform.co.za

# Feature Flags
EXPO_PUBLIC_ENABLE_AI_SUGGESTIONS=true
EXPO_PUBLIC_ENABLE_LIVE_TRANSLATION=true
EXPO_PUBLIC_ENABLE_CALL_RECORDING=true

# Analytics & Monitoring
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Push Notifications
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_ONE_SIGNAL_APP_ID=

# Payment/Subscription (if applicable)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox (for location features)
EXPO_PUBLIC_MAPBOX_TOKEN=

# Translation APIs
EXPO_PUBLIC_GOOGLE_TRANSLATION_API_KEY=
EXPO_PUBLIC_AZURE_TRANSLATION_KEY=

# Voice Synthesis
EXPO_PUBLIC_ELEVENLABS_API_KEY=
